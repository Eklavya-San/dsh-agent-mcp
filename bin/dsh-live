#!/usr/bin/env bash
# dsh-live: Runs DeepSeek Harness directly inside your integrated terminal with real-time reasoning stream.

set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STREAMER="${DIR}/dsh-stream.js"
CWD="$(pwd)"
TASK=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --cwd)
      CWD="$2"
      shift 2
      ;;
    *)
      if [ -z "$TASK" ]; then
        TASK="$1"
      else
        TASK="$TASK $1"
      fi
      shift
      ;;
  esac
done

if [ -z "$TASK" ]; then
  echo "Usage: dsh-live [--cwd <path>] \"<task prompt>\""
  exit 1
fi

cd "${CWD}"
exec node "${STREAMER}" "${TASK}"
